# herdr-tickets config (created by ht-init; commit it: it's shared project config).
# Keys and defaults: the herdr-tickets README. Check with ht-config.
#   MODE: docs/agents/issue-tracker.md says local markdown
#   BASE: the branch checked out here
#   CHECK: scripts/check.sh
#   SETUP: pnpm: unapproved dependency build scripts (e.g. esbuild) are warnings, not errors (pnpm 10+ fails a fresh install on them); approve them for good with pnpm approve-builds, which records the choice in pnpm-workspace.yaml
#   SETUP: install each project; copy ignored .env files from the main checkout ($2)
#   SETUP: given
MODE=local
BASE=main
MERGE=manual
CHECK='./scripts/check.sh'
SETUP='(cd backend && uv sync) && (cd frontend && pnpm install --frozen-lockfile --config.strict-dep-builds=false) && { [ ! -f "$2/backend/.env" ] || cp "$2/backend/.env" backend/.env; }'
MAX_PARALLEL=2
