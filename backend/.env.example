# Copy to backend/.env (gitignored) for the live demo with Claude. Without it the template
# provider runs offline.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Optional: also export trace spans to an OTLP/HTTP endpoint (Langfuse, Jaeger). Needs
# uv sync --extra otlp. Without it spans go to the local trace_span table only.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
